# Server
PORT=8080
ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=flashsale_db
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_ORDERS=flashsale.orders
KAFKA_CONSUMER_GROUP=flashsale-notification-group

# Worker Pool
WORKER_POOL_SIZE=10
WORKER_CHANNEL_BUFFER=1000
